# Banco Postgres (a Vercel preenche sozinha ao conectar o Neon)
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require
# Chave para assinar o login. Gere uma com: openssl rand -base64 32
SESSION_SECRET=troque-por-uma-string-aleatoria-longa
# Senha inicial dos usuários criados no primeiro deploy (todos são obrigados a trocar)
SEED_INITIAL_PASSWORD=12345
